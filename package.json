{
  "name": "dsh-wechat-mp",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: turn markdown into a typeset WeChat Official Account draft.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolbreezecoin/dsh-wechat-mp.git"
  },
  "homepage": "https://github.com/coolbreezecoin/dsh-wechat-mp#readme",
  "bugs": {
    "url": "https://github.com/coolbreezecoin/dsh-wechat-mp/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./render": {
      "types": "./lib/render/index.d.ts",
      "default": "./lib/render/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/themes/*.css",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "highlight.js": "^11.11.1",
    "juice": "^12.1.2",
    "marked": "^18.0.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "markdown"
  ]
}
